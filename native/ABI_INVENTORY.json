{
 "schema": "elpis.native-abi-inventory.v1",
 "baseline": {
  "commit": "9dc2c495bf1a4fbedc6fd84058d329c4f7bf00e3",
  "measured_build": "Release build of 18f2f4de3c1bacef4f5b6bc61ac5999ecd133038 (native tree equal to the baseline's)"
 },
 "rule": "Every listed library is built under its file name, carries its SONAME, exports exactly these elpis_* / ELPIS_* symbols and links exactly these Elpis libraries (DT_NEEDED). A relocation keeps this file unchanged; a change of exports or of the Elpis link graph is a versioned change recorded here in the same commit.",
 "amendments": [
  {
   "stage": "C (docs/NATIVE_SPLIT_CENSUS.md)",
   "change": "adds libelpis_ecs_c_authority.so and libelpis_ecs_c_authority_testing.so (ECS_C authority C ABI v1, include/elpis/ecs_c_authority.h); no export or link of any library above changes"
  },
  {
   "stage": "D (docs/NATIVE_SPLIT_CENSUS.md)",
   "change": "RuntimeCore C ABI v6 (include/elpis/runtime.h): libelpis_runtime.so and libelpis_runtime_testing.so add elpis_runtime_create_ecs_c, elpis_runtime_authority_status and elpis_runtime_authority_transition; they embed the ECS_C authority crate without its C ABI, so neither exports elpis_ecs_c_* and neither links libelpis_ecs_c_authority.so; no other export or link changes"
  },
  {
   "stage": "E (docs/NATIVE_SPLIT_CENSUS.md)",
   "change": "adds libelpis_ecs_c_hca.so (the ECS_C HCA native research substrate, C ABI v1, include/elpis/ecs_c_hca.h; research only, gated: no other library links it); it carries the substrate's SHA-256 helpers as libelpis_ecs_memory.so does; no export or link of any library above changes"
  },
  {
   "stage": "F (docs/NATIVE_SPLIT_CENSUS.md)",
   "change": "RuntimeCore C ABI v6, amended before any release: libelpis_runtime.so and libelpis_runtime_testing.so add elpis_runtime_authority_entity_at and elpis_runtime_authority_next_entity_id (read-only views of the held ECS_C authority, what the native operator host builds operator events from); no other export or link changes"
  },
  {
   "stage": "F (docs/NATIVE_SPLIT_CENSUS.md, section 9)",
   "change": "RuntimeCore C ABI v7 (include/elpis/runtime.h): standalone continuity retires into ECS_C. libelpis_continuity.so and libelpis_continuity_testing.so are removed; libelpis_runtime.so and libelpis_runtime_testing.so drop elpis_runtime_create and their re-export of continuity's C ABI (elpis_continuity_*, and the testing library's two continuity testing hooks), so the ECS_C authority, embedded without its C ABI, is their only durable authority; no export is added, and no other export or link changes"
  },
  {
   "stage": "DEV (docs/ECS_C_RELATIONAL.md, ECSC_DYNAMIC_RELATIONAL_DEV_R0)",
   "change": "adds libelpis_ecs_c_relational.so (the ECS_C relational view, C ABI v1, include/elpis/ecs_c_relational.h; DEV, not composed: no other library links it); it links libelpis_ecs_memory.so (relation keys, and the substrate's SHA-256 helpers that library carries) and no authority code; no export or link of any library above changes"
  },
  {
   "stage": "V1 (docs/ECS_C_SESSION.md, ECSC_VOLATILE_SESSION_R0; docs/ELPIS_MISSION.md, Amendment 3)",
   "change": "adds libelpis_ecs_c_session.so (the ECS_C volatile session authority, C ABI v1, include/elpis/ecs_c_session.h and the shared include/elpis/ecs_c_types.h): the ECS_C transition law in volatile memory only, no path, file or descriptor in its ABI; it links no Elpis library. The durable authority crate now consumes the law from this crate (embedded without its C ABI), so libelpis_ecs_c_authority.so, libelpis_ecs_c_authority_testing.so, libelpis_runtime.so and libelpis_runtime_testing.so keep their exports and links exactly; no export or link of any library above changes"
  }
 ],
