  "seed": "inputs.<name>.lineage_seed_base + index",
  "random": "one random.Random(inputs.<name>.random_seed) consumed only by the random family, in enumeration order: rng_seed = randrange(2**63), then kill_after = randint(1, max_learns[lineage] - 1)",
  "record_order": "records appear exactly once each, in increasing index"
 },
