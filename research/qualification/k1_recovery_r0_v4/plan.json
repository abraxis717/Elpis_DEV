 },
 "torn_offsets": {
  "slot": [
   "17",
   "127",
   "128 + capacity // 2",
   "128 + capacity - 32"
  ],
  "record": [
   24,
   50,
   100,
   144
  ],
  "rule": "run index modulo 4 selects the offset; capacity is the lineage's envelope_bytes. Each writes at least one byte that differs from the slot or record it tears (the slot generation at byte 16, the record generation at byte 23) and leaves the old checksum (slot header bytes 96..128 or the envelope trailer; record bytes 144..176), so the torn bytes can never complete a valid slot or record."
 },
