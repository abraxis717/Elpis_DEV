  "attack_layout": {
    "newest": "the record slot whose 8-byte little-endian generation at offset 32 is the higher of the two (both slots are complete before an attack)",
    "flip": "XOR 0xFF at the offset of the newest record",
    "shorten": "the newest record's file truncated to the length (in place, same inode)",
    "shorten_other": "the other record's file truncated to the length",
    "checksum": "bytes R-32..R: SHA-256('elpis.ecs_c.authority.record.v1\\0' || bytes 0..R-32)",
    "state_root": "bytes 176..208: SHA-256('elpis.ecs_c.authority.state.v1\\0' || lineage (48..80) || generation u64le || capacity u32le || state (256..R-576))",
    "forge_generation": "the newest record with its generation (32..40) raised by add; checksum recomputed; MAC unchanged; written over the newest",
    "forge_evolution": "the newest record with state bytes 56..64 (evolution revision) set to revision and 64..96 (evolution head) to SHA-256(head_label); state root and checksum recomputed; MAC unchanged; written over the newest",
    "substitute": "the newest record with its generation raised by add; checksum recomputed; MAC unchanged; written over the other slot",
    "copy_back": "both record files rewritten in place with the bytes saved after publication saved_after",
    "swap": "the two record files' bytes exchanged in place",
    "duplicate": "the other record file rewritten with the newest record's bytes",
    "witness_lost": "both witness files truncated to zero bytes (the authority directory: outside T1)"
  },
  "operator_actions": {
    "attack": "even run index: authority-reconcile with exactly the kind and digest `authority` reports; odd: first the same kind with a wrong digest (64 'e'), which must be refused with AUTHORITY_RECONCILE_MISMATCH, then the exact one",
    "witness": "as attack",
    "CANDIDATE_UNRESOLVED": "discard and adopt families: their own reconciliation of D2 again; every other family: reconcile --adopt of the candidate on even run indices, --discard on odd",
    "NOTHING_TO_RECOVER": "anchor family: create with the same arguments",
    "CHECKPOINT_MISSING": "no action exists: recorded; continuation not attempted",
    "otherwise": "no action"
  },
  "continuation": "unless the operator action leaves CHECKPOINT_MISSING: one more turn and publish in one process, then a fresh process's live and durable identities, which must both equal that publication",
  "coordinates": {
    "order": "families in plan order; within a family, points in order, then run index 0..runs-1",
    "index": "the 0-based position of the trial in that enumeration",
    "seed": "inputs.<name>.lineage_seed_base + index",
    "random": "one random.Random(inputs.<name>.random_seed), consumed only by the random family in enumeration order: turns = randint(1, max_turns); publish flags = [random() < publish_probability for each turn]; kill_after = randint(1, the child's output line count - 1)",
    "record_order": "records appear exactly once each, in increasing index"
  },
  "bounds": {
    "child_timeout_seconds": 120,
    "process_timeout_seconds": 600
  },
  "evidence_rule": "expect.evidence is the authority's evidence_count at the end of the trial (after the continuation, or after the reconciliation when no continuation exists): every turn commits one observation; an acknowledged publication carries the observations committed since the previous publication of its process; a checkpoint adoption carries none; an accepted rollback continues from the accepted record's count"
}
