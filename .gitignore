# Model weights and large binary assets are never committed.
*.gguf
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.onnx
*.npy
*.npz
*.pkl
# Exception: the two frozen ECS Binary Observation R0 laws (128 and 4120 bytes; their SHA-256 is bound by the
# freeze record). They are evidence, not model weights.
!research/ecs_binary_observer_r0/evidence/design/law_gray4.bin
!research/ecs_binary_observer_r0/evidence/design/law_sproj.bin

.DS_Store
*.swp

# H-ECS R2 raw runner output is telemetry, never committed evidence (research/hecs_r2/README.md).
hecs-r2.v1.design.json
hecs-r2.v1.calibration.json
hecs-r2.v1.dev.json
hecs-r2.v1.qual.json
